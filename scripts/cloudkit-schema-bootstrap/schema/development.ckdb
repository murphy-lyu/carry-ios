    RECORD TYPE CD_TransportSegment (
        CD_aircraftType             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_aircraftType_ckAsset     ASSET,
        CD_arriveDayOrder           INT64 QUERYABLE SORTABLE,
