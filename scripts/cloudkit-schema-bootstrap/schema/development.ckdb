        CD_departLocalMinutes       INT64 QUERYABLE SORTABLE,
        CD_distanceMeters           DOUBLE QUERYABLE SORTABLE,
        CD_durationMinutes          INT64 QUERYABLE SORTABLE,
        CD_entityName               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_eticketNumber            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_eticketNumber_ckAsset    ASSET,
        CD_fromAddress              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fromAddress_ckAsset      ASSET,
        CD_fromCode                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fromCode_ckAsset         ASSET,
        CD_fromLatitude             DOUBLE QUERYABLE SORTABLE,
        CD_fromLongitude            DOUBLE QUERYABLE SORTABLE,
        CD_fromName                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fromName_ckAsset         ASSET,
