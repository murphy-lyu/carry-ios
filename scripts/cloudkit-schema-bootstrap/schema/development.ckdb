        CD_cabinClass_ckAsset       ASSET,
        CD_carrier                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_carrier_ckAsset          ASSET,
        CD_coachNumber              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_coachNumber_ckAsset      ASSET,
        CD_confirmationCode         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_confirmationCode_ckAsset ASSET,
        CD_costAmount               DOUBLE QUERYABLE SORTABLE,
        CD_costCurrencyCode         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_costCurrencyCode_ckAsset ASSET,
        CD_costHomeAmount           DOUBLE QUERYABLE SORTABLE,
