    RECORD TYPE CD_TripBundle (
        CD_additionalDestinationsData         BYTES QUERYABLE SORTABLE,
        CD_additionalDestinationsData_ckAsset ASSET,
        CD_backgroundsData                    BYTES QUERYABLE SORTABLE,
