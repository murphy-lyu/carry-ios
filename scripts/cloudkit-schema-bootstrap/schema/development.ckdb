        CD_dateRange_ckAsset                  ASSET,
        CD_days                               INT64 QUERYABLE SORTABLE,
        CD_departureDate                      TIMESTAMP QUERYABLE SORTABLE,
        CD_destinationCity                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_destinationCity_ckAsset            ASSET,
        CD_dismissedSurpriseNames             BYTES QUERYABLE SORTABLE,
        CD_dismissedSurpriseNames_ckAsset     ASSET,
        CD_entityName                         STRING QUERYABLE SEARCHABLE SORTABLE,
