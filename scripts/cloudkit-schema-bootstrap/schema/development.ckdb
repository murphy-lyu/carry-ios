DEFINE SCHEMA

    RECORD TYPE CD_AutomationExecutionRecord (
        CD_connectionId        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fingerprint         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fingerprint_ckAsset ASSET,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_receiptData         BYTES QUERYABLE SORTABLE,
        CD_receiptData_ckAsset ASSET,
        CD_requestId           STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ItineraryAttachment (
        CD_addedAt               TIMESTAMP QUERYABLE SORTABLE,
        CD_displayName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_displayName_ckAsset   ASSET,
        CD_entityName            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fileName              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fileName_ckAsset      ASSET,
        CD_id                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw_ckAsset       ASSET,
        CD_moveReceipt           BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset   ASSET,
        CD_segment               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sortOrder             INT64 QUERYABLE SORTABLE,
        CD_stay                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_stop                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_thumbnailData         BYTES QUERYABLE SORTABLE,
        CD_thumbnailData_ckAsset ASSET,
        CD_urlString             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_urlString_ckAsset     ASSET,
        CD_utiOrExt              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_utiOrExt_ckAsset      ASSET,
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ItineraryDay (
