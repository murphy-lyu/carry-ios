        CD_fromTimeZoneId           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fromTimeZoneId_ckAsset   ASSET,
        CD_id                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_licensePlate             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_licensePlate_ckAsset     ASSET,
        CD_liveStatusData           BYTES QUERYABLE SORTABLE,
        CD_liveStatusData_ckAsset   ASSET,
        CD_modeRaw                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_modeRaw_ckAsset          ASSET,
        CD_moveReceipt              BYTES QUERYABLE SORTABLE,
